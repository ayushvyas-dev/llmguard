# ==============================================================================
# LLMGuard Backend Environment Configuration
# ==============================================================================
# Copy this file to .env in the backend directory:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
# Environment: 'development', 'test', or 'production'
APP_ENV=development

# Server bind host and port
HOST=127.0.0.1
PORT=8000

# Logging level: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# CORS Allowed Origins: comma-separated list of allowed web origins
ALLOWED_ORIGINS=http://localhost:3000

# Demo Mode: when true, all administrative mutations are restricted (UI-009)
DEMO_MODE=false

# Demo Admin Key: key recognized for zero-friction recruiter and portfolio demo access
DEMO_ADMIN_KEY=lga_dev_demo0000_recruiter_demo_access_key

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL) Settings
# ------------------------------------------------------------------------------
# Primary application connection pool (async SQLAlchemy with psycopg)
DATABASE_URL=postgresql+psycopg://llmguard:llmguard@localhost:5432/llmguard

# Direct unpooled connection URL (used by Alembic migrations on serverless/pooled DBs like Neon)
DATABASE_URL_DIRECT=postgresql+psycopg://llmguard:llmguard@localhost:5432/llmguard

# Connection pool sizing
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ------------------------------------------------------------------------------
# 3. Cache & Distributed Rate Limiter (Redis) Settings
# ------------------------------------------------------------------------------
# Redis connection URL (supports redis:// and rediss:// for TLS)
REDIS_URL=redis://localhost:6379/0

# Toggle Redis for sliding-window rate limiting (falls back to memory if false or unreachable)
REDIS_ENABLED=true

# Semantic response caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_SCHEMA_VERSION=1

# ------------------------------------------------------------------------------
# 4. Security & Cryptography Settings
# ------------------------------------------------------------------------------
# Secret pepper for HMAC-SHA256 client API key hashing.
# REQUIRED: Must be at least 32 characters in production!
API_KEY_PEPPER=dev-api-key-pepper-for-testing-only-at-least-32-chars

# Rate limiter failure behavior when Redis is unavailable: 'open' (allow) or 'closed' (reject)
RATE_LIMIT_FAIL_MODE=open

# Client request parameter validation: 'strict' (reject unknown params) or 'lenient'
UNSUPPORTED_PARAMETER_MODE=strict

# ------------------------------------------------------------------------------
# 5. Upstream LLM Providers & API Keys
# ------------------------------------------------------------------------------
# Comma-separated list of enabled provider adapters ('fake', 'groq', 'gemini')
PROVIDERS_ENABLED=fake,groq,gemini

# Groq Cloud API Key (format: gsk_...)
GROQ_API_KEY=

# Google Gemini API Key (format: AIzaSy...)
GEMINI_API_KEY=

# Active routing policy version (default: 1)
ROUTING_VERSION=1

# ------------------------------------------------------------------------------
# 6. Request Safeguards & Payload Constraints
# ------------------------------------------------------------------------------
# Maximum allowed request body size in bytes (default: 1 MB)
REQUEST_MAX_BODY_BYTES=1048576

# Maximum number of messages allowed per completion request
REQUEST_MAX_MESSAGES=50

# Maximum character count per message content
REQUEST_MAX_MESSAGE_CHARS=20000

# Maximum token count allowed in the max_tokens parameter
REQUEST_MAX_TOKENS=4096

# Tool schema and argument byte limits
REQUEST_MAX_TOOL_SCHEMA_BYTES=16384
REQUEST_MAX_TOOL_ARGUMENT_BYTES=8192

# ------------------------------------------------------------------------------
# 7. Default Rate Limits (Per Client)
# ------------------------------------------------------------------------------
# Default client rate limit (requests per minute)
DEFAULT_RATE_LIMIT_RPM=30

# Rate limit sliding window duration in seconds
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 8. Resilience, Fallback & Circuit Breakers
# ------------------------------------------------------------------------------
# Total end-to-end request deadline budget in seconds
REQUEST_DEADLINE_SECONDS=30.0

# Per-attempt timeout when calling an upstream provider
PER_ATTEMPT_TIMEOUT_SECONDS=10.0

# Max retries on transient errors before initiating provider fallback
MAX_RETRIES=2

# Exponential backoff parameters (seconds)
BACKOFF_BASE_SECONDS=0.5
BACKOFF_MAX_SECONDS=10.0
RETRY_AFTER_CAP_SECONDS=30.0

# Circuit breaker thresholds per provider
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0

# ------------------------------------------------------------------------------
# 9. Observability, Tracing & Data Retention
# ------------------------------------------------------------------------------
# Audit writer mode: 'async' (background worker queue) or 'sync' (write before response)
AUDIT_MODE=async

# Bounded queue size for asynchronous trace writer
TRACE_QUEUE_SIZE=1000

# Trace payload limits
TRACE_MAX_EVENTS=100
TRACE_MAX_BYTES=65536

# Retention periods for automated data lifecycle cleanup (days)
CONTENT_STORAGE_RETENTION_DAYS=7
TRACE_RETENTION_DAYS=30
SECURITY_EVENT_RETENTION_DAYS=90
USAGE_RETENTION_DAYS=365
