NODE_ENV=development
PORT=5000

# PostgreSQL Connection (Neon or local PostgreSQL with pgvector)
DATABASE_URL="postgresql://user:password@localhost:5432/llmguard?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/llmguard?schema=public"

# Redis Connection (Supports local Redis, Docker Compose, or Upstash Redis)
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_URL="redis://localhost:6379"

# LLM & Embedding Integrations
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Secret pepper for API Key HMAC hashing (never expose in production)
API_KEY_PEPPER="llmguard-default-pepper"

# Logging configuration ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL="info"

# Sliding Window Rate Limiting (per API key or client IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
