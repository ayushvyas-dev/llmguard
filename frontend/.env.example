# ==============================================================================
# LLMGuard Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local (or .env) in the frontend directory:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY NOTICE:
# - These variables are strictly SERVER-ONLY.
# - NEVER prefix these variables with NEXT_PUBLIC_ (this would bundle secrets into
#   client-side JavaScript sent to user browsers).
# - Client-side browser components communicate exclusively through Next.js proxy
#   route handlers (/api/proxy/... and /api/auth/...).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Gateway Connection
# ------------------------------------------------------------------------------
# Base URL of the LLMGuard FastAPI backend.
# Used by Next.js server-side route handlers and middleware to proxy requests.
# Default for local development: http://127.0.0.1:8000
BACKEND_API_URL=http://127.0.0.1:8000
DEMO_ADMIN_KEY=lga_dev_demo0000_recruiter_demo_access_key

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# ------------------------------------------------------------------------------
# Secret key used to cryptographically sign and verify JWT session cookies (HS256).
# REQUIRED IN PRODUCTION: Must be a cryptographically secure string of at least 32 characters.
# Generate with: openssl rand -base64 32
SESSION_SECRET=llmguard_dev_session_secret_key_at_least_32_bytes_long!

# ------------------------------------------------------------------------------
# 3. Environment & Node Settings (Optional)
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. End-to-End Testing (Optional)
# ------------------------------------------------------------------------------
# Target frontend URL for Playwright browser tests
PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:3000
